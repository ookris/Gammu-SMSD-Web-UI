[Unit]
Description=SMS daemon for Gammu (modem %i) – dodatkowy modem Gammu SMSD Web UI
Documentation=man:gammu-smsd(1)
After=mysql.service mariadb.service network-online.target

[Service]
EnvironmentFile=-/etc/default/gammu-smsd
# Katalog na PID tworzony przez systemd z prawami użytkownika usługi (także gdy działa na zwykłym koncie)
RuntimeDirectory=gammu-smsd-%i
ExecStart=/usr/bin/gammu-smsd --config=/etc/gammu-smsdrc-%i --pid=/run/gammu-smsd-%i/gammu-smsd.pid --daemon
ExecReload=/bin/kill -HUP $MAINPID
Type=forking
PIDFile=/run/gammu-smsd-%i/gammu-smsd.pid

[Install]
WantedBy=multi-user.target
